{
  "name": "Heir",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del heredero"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email de contacto del heredero"
    },
    "relationship": {
      "type": "string",
      "description": "Relaci\u00f3n con el titular (hijo, c\u00f3nyuge...)"
    },
    "allocation_percentage": {
      "type": "number",
      "default": 0,
      "description": "Porcentaje de la herencia asignado"
    }
  },
  "required": [
    "name",
    "email"
  ]
}